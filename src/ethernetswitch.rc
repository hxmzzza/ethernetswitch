PRODUCTVERSION  1,1,0,0
FILEOS          0x00040004L
FILETYPE        0x00000001L
FILESUBTYPE     0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ethernetswitch"
            VALUE "FileDescription",  "Outbound connection refresher"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "ethernetswitch"
            VALUE "OriginalFilename", "ethernetswitch.exe"
            VALUE "ProductName",      "ethernetswitch"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
